# Exemplo de configuração — copie para .env e edite os valores.

# ── Banco de dados Postgres ────────────────────────────────────────────────
# Formato: postgresql+psycopg://USER:PASS@HOST:PORT/DBNAME
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/precificador

# ── Usuário admin inicial ──────────────────────────────────────────────────
# Criado automaticamente na primeira execução, se a tabela "usuario" estiver
# vazia. Para trocar a senha depois, use a página de Administração.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=troque-me
ADMIN_NOME=Administrador
